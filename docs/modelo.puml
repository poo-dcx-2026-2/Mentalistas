@startuml
' Modelo de domínio do sistema: Entrega 1.
'
' Este arquivo é o ponto de partida. Substitua pelo modelo da sua equipe.
' O diagrama precisa corresponder ao código entregue.
'
' Para gerar a imagem: instale o plugin PlantUML no IntelliJ, ou use
'   plantuml docs/modelo.puml
' e versione a imagem gerada ao lado deste arquivo.

skinparam classAttributeIconSize 0
hide empty members

class Locadora {
    - AcervoDeJogos acervo
    - DadosdoUsuario usuarios
    - EmprestimosNaoImplementados emprestimos
    - RelatoriosNaoImplementados relatorios
    + acervo()
    + usuarios()
    + emprestimos()
    + relatorios()
    + salvar()
    + carregar()
}

class AcervoDeJogos {
    - List<Jogo> jogos
    + cadastrarItem()
    + buscarItem()
    + listarItens()
    + buscarPorTitulo()
    + buscarPorCategoria()
    + adicionarExemplar()
    + listarExemplares()
    + baixarExemplar()
}

class DadosdoUsuario {
    - usuarios : Map<String, UsuarioView>
    + cadastrarUsuario()
    + buscarUsuario()
    + listarUsuarios()
    + desativarUsuario()
    + reativarUsuario()
}

class Jogo {
    - String : codigo
    - String : titulo
    - String : autoria
    - String : categoria
    - int : ano
    - List<Exemplar> exemplares
    + getCodigo()
    + getTitulo()
    + getAutoria()
    + getCategoria()
    + getAno()
    + getExemplares()
}

class Exemplar {
    - String : tombo
    - Jogo : item
    - StatusExemplar : status
    + getTombo()
    + getItem()
    + getStatus()
    + setStatus()
}

Locadora --> AcervoDeJogos
Locadora --> DadosdoUsuario
Locadora --> EmprestimosNaoImplementados
Locadora --> RelatoriosNaoImplementados

AcervoDeJogos "1" --> "0..*" Jogo
Jogo "1" *-- "0..*" Exemplar
Exemplar --> Jogo

@enduml